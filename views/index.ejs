<%- include('template/cabecera.ejs') %>

    <main>
        <section class="home">
            
            <h1>RefriExpert</h1>
            <p><%= t('slogan') %></p>
            <a href="#contact"><%= t('contact_us') %></a>
        </section>

        <section class="advantagesAndBenefits">

            <div class="gridAAB">
                <div class="containerAAB">
                    <h2><%= t('advantages_benefits') %></h2>
                    <ol>
                        <li><%= t('advantage_1') %></li>
                        <li><%= t('advantage_2') %></li>
                        <li><%= t('advantage_3') %></li>
                        <li><%= t('advantage_4') %></li>
                        <li><%= t('advantage_5') %></li>
                    </ol>
                </div>

                <div class="AABimage"></div>
            </div>
        </section>

        <section class="about" id="about">
            <div class="gridAbout">
                <div class="aboutImage"></div>
                <div class="aboutContent">
                    <h2><%= t('about_me') %></h2>
                    <p><%= t('about_me_text') %></p>
                </div>
            </div>
        </section>

        <section class="services" id="services">

            <h2><%= t('services') %></h2>

            <div class="servicesGrid">
                
                <article>
                    <img loading="lazy" height="200" width="300" src="./images/img4.jpg" alt="<%= t('service_install_alt') %>">
                    <h3><%= t('service_install') %></h3>
                    <p><%= t('service_install_desc') %></p>
                </article>
            
                <article>
                    <img loading="lazy" height="200" width="300" src="./images/img6.jpg" alt="<%= t('service_diagnosis_alt') %>">
                    <h3><%= t('service_diagnosis') %></h3>
                    <p><%= t('service_diagnosis_desc') %></p>
                </article>
            
                <article>
                    <img loading="lazy" height="200" width="300" src="./images/img7.jpg" alt="<%= t('service_repair_alt') %>">
                    <h3><%= t('service_repair') %></h3>
                    <p><%= t('service_repair_desc') %></p>
                </article>
                
            </div>

            <div style="text-align:center; margin: 2em 0;">
                <a href="/payment" class="btn-payment" style="padding: 0.7em 2em; font-size: 1.1em; background: #007bff; color: #fff; border-radius: 5px; text-decoration: none;">
                    <%= t('go_to_payment') %>
                </a>
            </div>

        </section>

        <section class="testimonials" id="testimonials">
            <div class="gridTestimonials">
                <div class="testimonialsImage"></div>
                <div class="testimonialsContent">
                    <div class="testimonialIcon">
                        <svg  xmlns="http://www.w3.org/2000/svg"  width="48"  height="48"  viewBox="0 0 24 24"  fill="#f3f3f3"  class="icon icon-tabler icons-tabler-filled icon-tabler-user"><path stroke="none" d="M0 0h24v24H0z" fill="none"/><path d="M12 2a5 5 0 1 1 -5 5l.005 -.217a5 5 0 0 1 4.995 -4.783z" /><path d="M14 14a5 5 0 0 1 5 5v1a2 2 0 0 1 -2 2h-10a2 2 0 0 1 -2 -2v-1a5 5 0 0 1 5 -5h4z" /></svg>
                    </div>
                    <h2><%= t('testimonial') %></h2>
                    <p><%= t('testimonial_text') %></p>
                    <div class="testimonialAutor"><%= t('testimonial_author') %></div>
                    <div class="stars">
                        <svg width="120" height="24" viewBox="0 0 120 24" fill="none">
                            <g>
                                <polygon points="12,2 15,9 22,9 16,14 18,21 12,17 6,21 8,14 2,9 9,9" fill="#FFD700"/>
                                <polygon points="36,2 39,9 46,9 40,14 42,21 36,17 30,21 32,14 26,9 33,9" fill="#FFD700"/>
                                <polygon points="60,2 63,9 70,9 64,14 66,21 60,17 54,21 56,14 50,9 57,9" fill="#FFD700"/>
                                <polygon points="84,2 87,9 94,9 88,14 90,21 84,17 78,21 80,14 74,9 81,9" fill="#FFD700"/>
                                <polygon points="108,2 111,9 118,9 112,14 114,21 108,17 102,21 104,14 98,9 105,9" fill="#FFD700"/>
                            </g>
                        </svg>
                    </div>
                </div>
            </div>
        </section>

        <section class="contact" id="contact">

            <h2><%= t('contact_us') %></h2>

            <div class="gridContact">

                <div class="contactInfo">

                    <div class="direction">
                        <p><%= t('address_line1') %></p>
                        <p><%= t('address_line2') %></p>
                    </div>
                    
                    <div class="link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-mail">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                            <path d="M3 7l9 6l9 -6" />
                        </svg>
                        <strong><%= t('email') %>:</strong>
                        <a href="mailto:contacto@refriexpert.com">contacto@refriexpert.com</a>
                    </div>

                    <div class="link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-phone">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />
                        </svg>
                        <strong><%= t('phone') %>:</strong>
                        <a href="tel:+58 416-555-1234">+58 416-555-1234</a>
                    </div>

                    <div class="link">
                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="icon icon-tabler icons-tabler-outline icon-tabler-calendar-check">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"/>
                            <path d="M11.5 21h-5.5a2 2 0 0 1 -2 -2v-12a2 2 0 0 1 2 -2h12a2 2 0 0 1 2 2v6" />
                            <path d="M16 3v4" />
                            <path d="M8 3v4" />
                            <path d="M4 11h16" />
                            <path d="M15 19l2 2l4 -4" />
                        </svg>
                        <strong><%= t('schedule') %>:</strong>
                        <%= t('schedule_text') %>
                    </div>
                </div>

                <div class="contactForm">
                    <form id="form" action="/send#contact" method="post">
                        <input class="campo<% if (errors && errors.some(e => e.path === 'name')) { %> input-error<% } %>" type="text" id="name" name="name" placeholder="<%= t('name') %>" value="<%= data.name || '' %>">
                        <% if (errors) {%>
                            <% errors.forEach(error => { %>
                                <% if (error.path == 'name') { %>
                                    <p style="color: #FE2D48; padding: 0; margin: 0; text-align: center;"><%= error.msg %></p>
                                <% } %>
                            <% }); %>
                        <% } %>

                        <input class="campo<% if (errors && errors.some(e => e.path === 'email')) { %> input-error<% } %>" type="email" id="email" name="email" placeholder="<%= t('email') %>" value="<%= data.email || '' %>">
                        <% if (errors) {%>
                            <% errors.forEach(error => { %>
                                <% if (error.path == 'email') { %>
                                    <p style="color: #FE2D48; padding: 0; margin: 0; text-align: center;"><%= error.msg %></p>
                                <% } %>
                            <% }); %>
                        <% } %>

                        <input class="campo<% if (errors && errors.some(e => e.path === 'phone')) { %> input-error<% } %>" type="tel" id="phone" name="phone" placeholder="<%= t('phone') %>" value="<%= data.phone || '' %>">
                        <% if (errors) {%>
                            <% errors.forEach(error => { %>
                                <% if (error.path == 'phone') { %>
                                    <p style="color: #FE2D48; padding: 0; margin: 0; text-align: center;"><%= error.msg %></p>
                                <% } %>
                            <% }); %>
                        <% } %>

                        <textarea class="campo<% if (errors && errors.some(e => e.path === 'message')) { %> input-error<% } %>" name="message" id="message" placeholder="<%= t('message') %>"><%= data.message || '' %></textarea>
                        <% if (errors) {%>
                            <% errors.forEach(error => { %>
                                <% if (error.path == 'message') { %>
                                    <p style="color: #FE2D48; padding: 0; margin: 0; text-align: center;"><%= error.msg %></p>
                                <% } %>
                            <% }); %>
                        <% } %>

                        <div class="g-recaptcha" data-sitekey="6Lf710crAAAAALNoQ1kK0djLTHePRVOoafx5UYrr"></div>
                        
                        <% if (errors && errors.length) { %>
                            <% errors.forEach(error => { %>
                                <% if (!error.path) { %>
                                <p class="form-error" style="color: #FE2D48; text-align: center;"><%= error.msg %></p>
                                <% } %>
                            <% }); %>
                        <% } %>

                        <button type="submit"><%= t('send') %></button>
                    </form>
                    <script>
                    document.getElementById('form').addEventListener('submit', function() {
                        gtag('event', 'form_submit', {
                            'event_category': 'formulario',
                            'event_label': 'contacto'
                        });
                    });
                    </script>
                </div>

            </div>

        </section>
    </main>

<%- include('template/footer.ejs') %>