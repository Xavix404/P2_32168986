<%- include('template/cabecera.ejs') %>

<main>
    <div class="wrapper">
        <div class="payment">
            <h2><%= t('payment') %></h2>
            <form class="form" action="/payment" method="POST">
                <div class="space iconRelative">
                    <label for="email"><%= t('email') %></label>
                    <input type="email" id="email" class="input" name="email" placeholder="example@gmail.com" required>
                    <ion-icon name="mail-outline"></ion-icon>
                </div>
                <div class="space iconRelative">
                    <label for="service"><%= t('service') %></label>
                    <select class="input selectService" id="service" name="service" required>
                        <option value="reparacion"><%= t('service_repair') %></option>
                        <option value="mantenimiento"><%= t('service_maintenance') %></option>
                        <option value="diagnostico"><%= t('service_diagnosis') %></option>
                    </select>
                </div> 
                <div class="space iconRelative">
                    <label for="cardHolder"><%= t('cardholder_name') %></label>
                    <input type="text" id="cardHolder" class="input" name="cardHolder" placeholder="Fidel Castro" required>
                    <ion-icon name="person-circle-outline"></ion-icon>
                </div>
                <div class="space iconRelative">
                    <label for="cardNumber"><%= t('card_number') %></label>
                    <input type="text" id="cardNumber" class="input" name="cardNumber" placeholder="<%= t('card_number_placeholder') %>" required data-mask="0000 0000 0000 0000">
                    <ion-icon name="card-outline"></ion-icon>
                </div>
                <div class="card_grp space">
                    <div class="cardItem iconRelative">
                        <label for="expiryMonth"><%= t('month') %></label>
                        <input type="text" id="expiryMonth" class="input" name="expiryMonth" placeholder="MM" required data-mask="00">
                        <ion-icon name="calendar-outline"></ion-icon>
                    </div>
                    <div class="cardItem iconRelative">
                        <label for="expiryYear"><%= t('year') %></label>
                        <input type="text" id="expiryYear" class="input" name="expiryYear" placeholder="AAAA" required data-mask="0000">
                        <ion-icon name="calendar-outline"></ion-icon>
                    </div>
                </div>
                <div class="cardItem iconRelative">
                    <label for="cvv">CVC</label>
                    <input type="text" id="cvv" class="input" name="cvv" placeholder="000" required data-mask="000">
                    <ion-icon name="key-outline"></ion-icon>
                </div>
                <div class="card_grp space">
                    <div class="space iconRelative">
                        <label for="amount"><%= t('amount') %></label>
                        <input
                            readonly
                            type="text"
                            id="amount"
                            name="amount_display"
                            class="input"
                            value="<%= formatCurrency(1000, lang === 'es' ? 'VBS' : 'USD') %>"
                            tabindex="-1"
                            aria-readonly="true"
                        >
                        <input type="hidden" id="amountHidden" name="amount" value="1000">
                    </div>
                    <div class="space iconRelative">
                        <label for="currency"><%= t('currency') %></label>
                        <select disabled class="input" id="currency" name="currency" required>
                            <% if (lang === 'es') { %>
                                <option value="VBS">VBS</option>
                            <% } else { %>
                                <option value="USD">USD</option>
                            <% } %>
                        </select>
                        <input type="hidden" name="currency" value="<%= lang === 'es' ? 'VBS' : 'USD' %>">
                    </div>
                </div>

                <button type="submit" class="btn"><%= t('pay') %></button>
                <% if (typeof error !== 'undefined') { %>
                    <p style="color:red;"><%= error %></p>
                <% } %>
            </form>
        </div>
    </div>
</main>

<script>
const servicePrices = {
    reparacion: 1000,
    mantenimiento: 700,
    diagnostico: 400
};

const lang = "<%= lang %>";
const currency = lang === 'es' ? 'VBS' : 'USD';

const formatCurrency = (amount, currency) => {
    if (lang === 'es') {
        return new Intl.NumberFormat('es-VE', { style: 'currency', currency: currency === 'VBS' ? 'VES' : currency, minimumFractionDigits: 2 }).format(amount);
    } else {
        return new Intl.NumberFormat('en-US', { style: 'currency', currency: currency === 'VBS' ? 'USD' : currency, minimumFractionDigits: 2 }).format(amount);
    }
};

const serviceSelect = document.getElementById('service');
const amountInput = document.getElementById('amount');
const amountHidden = document.getElementById('amountHidden');

function updateAmount() {
    const price = servicePrices[serviceSelect.value];
    amountInput.value = formatCurrency(price, currency);
    amountHidden.value = price;
}

serviceSelect.addEventListener('change', updateAmount);

// Inicializa el monto al cargar la página
updateAmount();
</script>

<%- include('template/footer.ejs') %>